--  {{ project_name }} entry point.
with Ada.Command_Line;
with Ada.Text_IO;
with {{ class_name }}.Greeter;

procedure Main is
   use Ada.Command_Line;
   use Ada.Text_IO;
begin
   if Argument_Count = 0 then
      Put_Line ({{ class_name }}.Greeter.Greet);
      return;
   end if;

   declare
      Arg : constant String := Argument (1);
   begin
      if Arg = "--version" or else Arg = "-V" then
         Put_Line ({{ class_name }}.Greeter.Version);
      elsif Arg = "--help" or else Arg = "-h" then
         Put_Line ("{{ project_name }} " & {{ class_name }}.Greeter.Version);
         Put_Line ("");
         Put_Line ("Usage: {{ bin_name }} [name]");
         Put_Line ("       {{ bin_name }} --version");
      else
         Put_Line ({{ class_name }}.Greeter.Greet (Arg));
      end if;
   end;
end Main;
