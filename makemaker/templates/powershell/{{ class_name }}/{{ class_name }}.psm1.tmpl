# {{ project_name }} - {{ description }}

$script:Version = '{{ version }}'

function Get-Greeting {
    <#
    .SYNOPSIS
        Returns a greeting for the given name.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Position = 0)]
        [string]$Name = 'world'
    )

    if ([string]::IsNullOrWhiteSpace($Name)) { $Name = 'world' }
    return "Hello, $Name!"
}

function Add-Number {
    [CmdletBinding()]
    [OutputType([int])]
    param(
        [Parameter(Mandatory)][int]$Left,
        [Parameter(Mandatory)][int]$Right
    )

    return $Left + $Right
}

function Get-{{ class_name }}Version {
    [CmdletBinding()]
    [OutputType([string])]
    param()

    return $script:Version
}

Export-ModuleMember -Function Get-Greeting, Add-Number, Get-{{ class_name }}Version
