(* {{ project_name }} - tests. Exits non-zero on failure. *)

let passed = ref 0
let failures = ref 0

let check what expected actual =
  if expected = actual then begin
    incr passed;
    Printf.printf "ok   - %s\n" what
  end else begin
    incr failures;
    Printf.printf "FAIL - %s\n  expected: %s\n  actual:   %s\n" what expected actual
  end

let () =
  check "greets the world" "Hello, world!" (Greeter.greet "world");
  check "greets a name" "Hello, Ada!" (Greeter.greet "Ada");
  check "adds two numbers" "5" (string_of_int (Greeter.add 2 3));
  check "reports version" "{{ version }}" Greeter.version;
  Printf.printf "\n%d passed, %d failed\n" !passed !failures;
  if !failures > 0 then exit 1
