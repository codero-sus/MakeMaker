## {{ project_name }} entry point.

import std/os
import {{ identifier }}

let args = commandLineParams()
let first = if args.len > 0: args[0] else: ""

case first
of "--version", "-V":
  echo version
of "--help", "-h":
  echo "{{ project_name }} " & version
  echo ""
  echo "Usage: {{ bin_name }} [name]"
  echo "       {{ bin_name }} --version"
else:
  echo greet(if first.len > 0: first else: "world")
