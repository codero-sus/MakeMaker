# {{ app_name }} -- generated by MakeMaker
#
# Targets: run, test, clean, install, help
# No third-party packages are required for any of these.

PKG      := {{ identifier }}
PYTHON   ?= python3
SRCDIR   := src
TESTDIR  := tests

export PYTHONPATH := $(CURDIR)/$(SRCDIR)

.PHONY: run test lint clean install help

run:
	$(PYTHON) -m $(PKG)

test:
	$(PYTHON) -m unittest discover -s $(TESTDIR) -t $(TESTDIR) -v

lint:
	$(PYTHON) -m compileall -q $(SRCDIR) $(TESTDIR)

install:
	$(PYTHON) -m pip install .

clean:
	rm -rf build dist ./*.egg-info
	find . -name '__pycache__' -type d -prune -exec rm -rf {} +
	find . -name '*.py[co]' -delete

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make run       run the CLI (python -m $(PKG))"
	@echo "  make test      run the unittest suite"
	@echo "  make lint      byte-compile every module"
	@echo "  make install   pip install this package"
	@echo "  make clean     remove build output and caches"
