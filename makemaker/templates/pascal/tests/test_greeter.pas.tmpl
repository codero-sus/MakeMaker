{ {{ project_name }} - tests. Exits non-zero on failure. }
program test_{{ identifier }};

uses
  SysUtils, greeter;

var
  Failures: Integer = 0;

procedure Check(const AWhat, AExpected, AActual: string);
begin
  if AExpected = AActual then
    WriteLn('ok   - ', AWhat)
  else
  begin
    WriteLn('FAIL - ', AWhat);
    WriteLn('  expected: ', AExpected);
    WriteLn('  actual:   ', AActual);
    Inc(Failures);
  end;
end;

begin
  Check('greets the world', 'Hello, world!', Greet);
  Check('greets a name', 'Hello, Ada!', Greet('Ada'));
  Check('adds two numbers', '5', IntToStr(Add(2, 3)));
  Check('reports version', '{{ version }}', AppVersion);

  if Failures > 0 then
    ExitCode := 1;
end.
