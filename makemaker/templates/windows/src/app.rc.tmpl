/* {{ app_name }} -- Win32 resources. Generated by MakeMaker. */
#include <windows.h>

#include "resource.h"

/* Application manifest (DPI awareness, common controls v6). */
1 24 "{{ class_name }}.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION {{ version | replace('.', ',') }},0
 PRODUCTVERSION {{ version | replace('.', ',') }},0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "{{ company }}"
            VALUE "FileDescription", "{{ app_summary }}"
            VALUE "FileVersion", "{{ version }}"
            VALUE "InternalName", "{{ identifier }}"
            VALUE "OriginalFilename", "{{ bin_name }}.exe"
            VALUE "ProductName", "{{ app_name }}"
            VALUE "ProductVersion", "{{ version }}"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
