# {{ app_name }} -- generated by MakeMaker
cmake_minimum_required(VERSION 3.16)

project({{ identifier }}
        VERSION {{ version }}
        DESCRIPTION "{{ app_summary }}"
{% if is_c %}
        LANGUAGES C)
{% else %}
        LANGUAGES CXX)
{% endif %}

{% if is_c %}
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
{% else %}
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
{% endif %}

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE Release)
endif()

{% if is_gui %}
if(WIN32)
  enable_language(RC)
endif()

add_executable({{ bin_name }} WIN32
  src/app.{{ source_ext }}
  src/winmain.{{ source_ext }}
  src/app.rc)
{% else %}
add_executable({{ bin_name }}
  src/app.{{ source_ext }}
  src/main.{{ source_ext }})
{% endif %}

target_include_directories({{ bin_name }} PRIVATE src)

if(MSVC)
  target_compile_options({{ bin_name }} PRIVATE /W4 /utf-8)
  target_compile_definitions({{ bin_name }} PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
else()
  target_compile_options({{ bin_name }} PRIVATE -Wall -Wextra)
  target_compile_definitions({{ bin_name }} PRIVATE UNICODE _UNICODE NOMINMAX WIN32_LEAN_AND_MEAN)
{% if is_gui %}
  target_link_options({{ bin_name }} PRIVATE -mwindows)
{% endif %}
endif()

{% if is_console %}
enable_testing()
file(GLOB TEST_SOURCES CONFIGURE_DEPENDS "tests/*.{{ source_ext }}")
if(TEST_SOURCES)
  add_executable(test_{{ bin_name }} ${TEST_SOURCES} src/app.{{ source_ext }})
  target_include_directories(test_{{ bin_name }} PRIVATE src)
  add_test(NAME {{ bin_name }}_tests COMMAND test_{{ bin_name }})
endif()
{% endif %}

install(TARGETS {{ bin_name }} RUNTIME DESTINATION bin)
