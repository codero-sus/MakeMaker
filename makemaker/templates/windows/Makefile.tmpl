# {{ app_name }} -- generated by MakeMaker
# MinGW-w64 build. With Visual Studio, prefer CMake:
#   cmake -S . -B build && cmake --build build --config Release

APP      := {{ bin_name }}
SRCDIR   := src
BUILDDIR := build
{% if is_c %}
CC       ?= gcc
COMPILER := $(CC)
STD      := -std={{ c_standard }}
EXT      := c
{% else %}
CXX      ?= g++
COMPILER := $(CXX)
STD      := -std={{ cpp_standard }}
EXT      := cpp
{% endif %}
WINDRES  ?= windres

WARN     := -Wall -Wextra
OPT      ?= -O2 -g
DEFS     := -DUNICODE -D_UNICODE -DNOMINMAX -DWIN32_LEAN_AND_MEAN
LIBS     := {% if is_gui %}-lgdi32 -luser32{% endif %}

CFLAGS   += $(STD) $(WARN) $(OPT) $(DEFS) -I$(SRCDIR)

SOURCES  := $(wildcard $(SRCDIR)/*.$(EXT))
OBJECTS  := $(SOURCES:$(SRCDIR)/%=$(BUILDDIR)/%.o)
{% if is_gui %}
OBJECTS  += $(BUILDDIR)/app.res.o
{% endif %}

.PHONY: all run test clean help
.DELETE_ON_ERROR:

all: $(BUILDDIR)/$(APP).exe

$(BUILDDIR)/$(APP).exe: $(OBJECTS)
	@mkdir -p $(BUILDDIR)
	$(COMPILER) $(OBJECTS) $(LIBS) {% if is_gui %}-mwindows {% endif %}-o $@

$(BUILDDIR)/%.o: $(SRCDIR)/%
	@mkdir -p $(dir $@)
	$(COMPILER) $(CFLAGS) -c $< -o $@

{% if is_gui %}
$(BUILDDIR)/app.res.o: $(SRCDIR)/app.rc $(SRCDIR)/resource.h $(SRCDIR)/{{ class_name }}.manifest
	@mkdir -p $(BUILDDIR)
	$(WINDRES) -i $(SRCDIR)/app.rc -o $@

{% endif %}
run: all
	./$(BUILDDIR)/$(APP).exe

{% if is_console %}
TEST_SOURCES := $(wildcard tests/*.{{ source_ext }})
TEST_OBJECTS := $(TEST_SOURCES:tests/%=$(BUILDDIR)/tests/%.o)

test: $(BUILDDIR)/app.$(EXT).o $(TEST_OBJECTS)
	$(COMPILER) $^ $(LIBS) -o $(BUILDDIR)/test_$(APP).exe
	./$(BUILDDIR)/test_$(APP).exe

$(BUILDDIR)/tests/%.o: tests/%
	@mkdir -p $(dir $@)
	$(COMPILER) $(CFLAGS) -c $< -o $@

{% endif %}
clean:
	rm -rf $(BUILDDIR)

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make            build $(BUILDDIR)/$(APP).exe"
	@echo "  make run        build and run"
{% if is_console %}
	@echo "  make test       build and run the tests"
{% endif %}
	@echo "  make clean      remove $(BUILDDIR)"
