# {{ app_name }} -- generated by MakeMaker
#
# Targets: all (default), run, test, clean, install, help

APP      := {{ bin_name }}
PREFIX   ?= /usr/local
SRCDIR   := src
BUILDDIR := build
{% if is_gui %}

BUNDLE     := $(BUILDDIR)/{{ class_name }}.app
CONTENTS   := $(BUNDLE)/Contents
MACOSDIR   := $(CONTENTS)/MacOS
CC         ?= clang
STD        := -std=gnu11
WARN       := -Wall -Wextra
OPT        ?= -O2 -g
OBJCFLAGS  := -fobjc-arc
FRAMEWORKS := -framework Cocoa
DEPLOYMENT := -mmacosx-version-min={{ macos_deployment_target }}

SOURCES    := $(wildcard $(SRCDIR)/*.m)
OBJECTS    := $(SOURCES:$(SRCDIR)/%=$(BUILDDIR)/%.o)

CFLAGS     += $(STD) $(WARN) $(OPT) $(OBJCFLAGS) $(DEPLOYMENT) -I$(SRCDIR)

.PHONY: all run clean install help codesign
.DELETE_ON_ERROR:

all: $(BUNDLE)

$(BUNDLE): $(OBJECTS) Info.plist
	@mkdir -p $(MACOSDIR)
	$(CC) $(OBJECTS) $(FRAMEWORKS) $(DEPLOYMENT) -o $(MACOSDIR)/$(APP)
	cp Info.plist $(CONTENTS)/Info.plist
	@echo "built $(BUNDLE)"

$(BUILDDIR)/%.o: $(SRCDIR)/%
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

codesign: $(BUNDLE)
	codesign --force --sign - $(BUNDLE)

run: all
	open $(BUNDLE)

install: all
	install -d $(DESTDIR)/Applications
	cp -R $(BUNDLE) $(DESTDIR)/Applications/

clean:
	rm -rf $(BUILDDIR)

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make            build $(BUNDLE)"
	@echo "  make run        build and open the app"
	@echo "  make codesign   ad-hoc sign the bundle"
	@echo "  make install    copy into /Applications"
	@echo "  make clean      remove $(BUILDDIR)"
{% else %}

{% if is_c %}
CC       ?= clang
COMPILER := $(CC)
STD      := -std={{ c_standard }}
EXT      := c
{% else %}
CXX      ?= clang++
COMPILER := $(CXX)
STD      := -std={{ cpp_standard }}
EXT      := cpp
{% endif %}

WARN     := -Wall -Wextra
OPT      ?= -O2 -g
DEPLOYMENT := -mmacosx-version-min={{ macos_deployment_target }}

CFLAGS   += $(STD) $(WARN) $(OPT) $(DEPLOYMENT) -I$(SRCDIR)
LDFLAGS  +=
LDLIBS   +=

SOURCES  := $(wildcard $(SRCDIR)/*.$(EXT))
OBJECTS  := $(SOURCES:$(SRCDIR)/%=$(BUILDDIR)/%.o)

.PHONY: all run test clean install help
.DELETE_ON_ERROR:

all: $(BUILDDIR)/$(APP)

$(BUILDDIR)/$(APP): $(OBJECTS)
	@mkdir -p $(dir $@)
	$(COMPILER) $(OBJECTS) $(LDFLAGS) $(LDLIBS) -o $@

$(BUILDDIR)/%.o: $(SRCDIR)/%
	@mkdir -p $(dir $@)
	$(COMPILER) $(CFLAGS) -c $< -o $@

run: all
	./$(BUILDDIR)/$(APP)

TEST_SOURCES := $(wildcard tests/*.{{ source_ext }})
TEST_OBJECTS := $(TEST_SOURCES:tests/%=$(BUILDDIR)/tests/%.o)

test: $(BUILDDIR)/app.$(EXT).o $(TEST_OBJECTS)
	$(COMPILER) $^ $(LDFLAGS) $(LDLIBS) -o $(BUILDDIR)/test_$(APP)
	./$(BUILDDIR)/test_$(APP)

$(BUILDDIR)/tests/%.o: tests/%
	@mkdir -p $(dir $@)
	$(COMPILER) $(CFLAGS) -c $< -o $@

install: all
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 0755 $(BUILDDIR)/$(APP) $(DESTDIR)$(PREFIX)/bin/$(APP)

clean:
	rm -rf $(BUILDDIR)

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make            build $(BUILDDIR)/$(APP)"
	@echo "  make run        build and run"
	@echo "  make test       build and run the tests"
	@echo "  make install    install into $(PREFIX)/bin"
	@echo "  make clean      remove $(BUILDDIR)"
{% endif %}
