// {{ app_name }} -- tests. Generated by MakeMaker.
//
// Built and run by 'make test'. Plain assertions rather than XCTest, so the
// target needs nothing but swiftc and exits non-zero on the first failure.

import Foundation

func expect(_ condition: Bool, _ message: String, line: Int = #line) {
    guard condition else {
        let text = "FAIL (line \(line)): \(message)\n"
        FileHandle.standardError.write(Data(text.utf8))
        exit(1)
    }
    print("ok - \(message)")
}

expect(sumTwo(2, 3) == 5, "sumTwo(2, 3) == 5")
expect(sumTwo(-4, 4) == 0, "sumTwo(-4, 4) == 0")
expect(sumTwo(0, 0) == 0, "sumTwo(0, 0) == 0")
expect(appName == "{{ app_name }}", "appName is \(appName)")
expect(greeting() == "{{ app_name }} says hello (2 + 3 = 5)", "greeting() is correct")

print("{{ app_name }}: all tests passed")
