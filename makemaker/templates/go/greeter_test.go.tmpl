package main

import "testing"

func TestSumTwo(t *testing.T) {
	cases := []struct {
		name string
		a    int
		b    int
		want int
	}{
		{"positive", 2, 3, 5},
		{"negative", -4, 4, 0},
		{"zeroes", 0, 0, 0},
	}

	for _, testCase := range cases {
		t.Run(testCase.name, func(t *testing.T) {
			if got := SumTwo(testCase.a, testCase.b); got != testCase.want {
				t.Errorf("SumTwo(%d, %d) = %d, want %d", testCase.a, testCase.b, got, testCase.want)
			}
		})
	}
}

