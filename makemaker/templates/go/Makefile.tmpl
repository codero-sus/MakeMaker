# {{ app_name }} -- generated by MakeMaker
#
# Targets: build (default), run, test, fmt, vet, clean, help

APP     := {{ bin_name }}
MODULE  := {{ domain }}/{{ slug }}
BUILDDIR := build
GO      ?= go

.PHONY: build run test fmt vet clean help

build:
	@mkdir -p $(BUILDDIR)
	$(GO) build -o $(BUILDDIR)/$(APP) .

run:
	$(GO) run .

test:
	$(GO) test ./... -v

fmt:
	$(GO) fmt ./...

vet:
	$(GO) vet ./...

clean:
	rm -rf $(BUILDDIR)
	$(GO) clean

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make build     build $(BUILDDIR)/$(APP)"
	@echo "  make run       go run ."
	@echo "  make test      go test ./... -v"
	@echo "  make fmt       gofmt the sources"
	@echo "  make vet       go vet"
	@echo "  make clean     remove build output"
