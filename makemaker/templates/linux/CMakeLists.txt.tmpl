# {{ app_name }} -- generated by MakeMaker
cmake_minimum_required(VERSION 3.16)

project({{ identifier }}
        VERSION {{ version }}
        DESCRIPTION "{{ app_summary }}"
{% if is_c %}
        LANGUAGES C)
{% else %}
        LANGUAGES CXX)
{% endif %}

{% if is_c %}
set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)
{% else %}
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
{% endif %}

if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release)
endif()

{% if is_gui %}
find_package(PkgConfig REQUIRED)
pkg_check_modules(GTK4 REQUIRED IMPORTED_TARGET gtk4)
{% endif %}

file(GLOB APP_SOURCES CONFIGURE_DEPENDS "src/*.{{ source_ext }}")
add_executable({{ bin_name }} ${APP_SOURCES})
target_include_directories({{ bin_name }} PRIVATE src)
target_compile_options({{ bin_name }} PRIVATE -Wall -Wextra)
{% if is_gui %}
target_link_libraries({{ bin_name }} PRIVATE PkgConfig::GTK4)
{% endif %}

{% if is_console %}
enable_testing()
file(GLOB TEST_SOURCES CONFIGURE_DEPENDS "tests/*.{{ source_ext }}")
if(TEST_SOURCES)
  add_executable(test_{{ bin_name }} ${TEST_SOURCES} src/app.{{ source_ext }})
  target_include_directories(test_{{ bin_name }} PRIVATE src)
  add_test(NAME {{ bin_name }}_tests COMMAND test_{{ bin_name }})
endif()
{% endif %}

install(TARGETS {{ bin_name }} RUNTIME DESTINATION bin)
