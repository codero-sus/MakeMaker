# {{ app_name }} -- generated by MakeMaker
#
# Targets: build (default), test, run, clean, help
# Everything here is a thin wrapper around xcodebuild / xcrun simctl.

PROJECT     := {{ class_name }}.xcodeproj
SCHEME      := {{ class_name }}
BUNDLE_ID   := {{ bundle_id }}
SIMULATOR   ?= iPhone 15
DESTINATION ?= generic/platform=iOS Simulator
XCODEBUILD  ?= xcodebuild

.PHONY: build test run clean help simulators

build:
	$(XCODEBUILD) -project $(PROJECT) -scheme $(SCHEME) \
		-destination "$(DESTINATION)" -configuration Debug build

test:
	$(XCODEBUILD) -project $(PROJECT) -scheme $(SCHEME) \
		-destination "platform=iOS Simulator,name=$(SIMULATOR)" test

run: build
	@device=$$(xcrun simctl list devices available | grep -m1 "$(SIMULATOR)" | grep -oE '[0-9A-F-]{36}'); \
	if [ -z "$$device" ]; then \
		echo "no available simulator matching '$(SIMULATOR)'; try 'make simulators'"; \
		exit 1; \
	fi; \
	xcrun simctl boot "$$device" 2>/dev/null || true; \
	open -a Simulator; \
	app=$$(find ~/Library/Developer/Xcode/DerivedData -type d -name "{{ class_name }}.app" \
		-path "*Debug-iphonesimulator*" | head -1); \
	if [ -z "$$app" ]; then echo "could not locate the built .app"; exit 1; fi; \
	xcrun simctl install "$$device" "$$app"; \
	xcrun simctl launch "$$device" $(BUNDLE_ID)

simulators:
	xcrun simctl list devices available

clean:
	$(XCODEBUILD) -project $(PROJECT) -scheme $(SCHEME) clean

help:
	@echo "{{ app_name }} -- available targets"
	@echo "  make build        build for $(DESTINATION)"
	@echo "  make test         run the XCTest target on '$(SIMULATOR)'"
	@echo "  make run          build, boot a simulator and launch"
	@echo "  make simulators   list available simulators"
	@echo "  make clean        xcodebuild clean"
