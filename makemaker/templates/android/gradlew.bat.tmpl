@rem {{ app_name }} -- Gradle launcher for Windows. Generated by MakeMaker.
@echo off
setlocal

set GRADLE_VERSION={{ gradle_version }}
set APP_HOME=%~dp0
set DIST_ROOT=%APP_HOME%.gradle-dist
set GRADLE_HOME=%DIST_ROOT%\gradle-%GRADLE_VERSION%

where gradle >nul 2>nul
if %errorlevel%==0 (
    gradle %*
    goto :end
)

if exist "%GRADLE_HOME%\bin\gradle.bat" (
    call "%GRADLE_HOME%\bin\gradle.bat" %*
    goto :end
)

echo gradlew: no Gradle on PATH.
echo gradlew: download https://services.gradle.org/distributions/gradle-%GRADLE_VERSION%-bin.zip
echo gradlew: and unzip it into %DIST_ROOT% so that %GRADLE_HOME%\bin\gradle.bat exists.
exit /b 1

:end
endlocal
