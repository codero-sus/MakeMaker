#!/bin/sh
#
# {{ app_name }} -- Gradle launcher. Generated by MakeMaker.
#
# Unlike the stock Gradle wrapper there is no binary jar checked in here:
# this script uses a Gradle already on PATH when there is one, otherwise it
# downloads Gradle {{ gradle_version }} into .gradle-dist/ on first use.

set -e

GRADLE_VERSION="{{ gradle_version }}"
APP_HOME=$(cd "$(dirname "$0")" && pwd)
DIST_ROOT="$APP_HOME/.gradle-dist"
GRADLE_HOME="$DIST_ROOT/gradle-$GRADLE_VERSION"
URL="https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"

if [ -n "$GRADLE_HOME_OVERRIDE" ] && [ -x "$GRADLE_HOME_OVERRIDE/bin/gradle" ]; then
    exec "$GRADLE_HOME_OVERRIDE/bin/gradle" "$@"
fi

if command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
fi

if [ -x "$GRADLE_HOME/bin/gradle" ]; then
    exec "$GRADLE_HOME/bin/gradle" "$@"
fi

echo "gradlew: no Gradle on PATH; bootstrapping Gradle $GRADLE_VERSION" >&2
mkdir -p "$DIST_ROOT"
ARCHIVE="$DIST_ROOT/gradle-$GRADLE_VERSION-bin.zip"

if command -v curl >/dev/null 2>&1; then
    curl -fL --retry 3 -o "$ARCHIVE" "$URL"
elif command -v wget >/dev/null 2>&1; then
    wget -O "$ARCHIVE" "$URL"
else
    echo "gradlew: need curl or wget to download Gradle" >&2
    echo "gradlew: or install Gradle $GRADLE_VERSION and put it on PATH" >&2
    exit 1
fi

if ! command -v unzip >/dev/null 2>&1; then
    echo "gradlew: need unzip to unpack $ARCHIVE" >&2
    exit 1
fi

unzip -q "$ARCHIVE" -d "$DIST_ROOT"
rm -f "$ARCHIVE"

exec "$GRADLE_HOME/bin/gradle" "$@"
