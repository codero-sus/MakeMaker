//! {{ app_name }} -- command line entry point.
//!
//! Generated by MakeMaker.

use std::env;
use std::process::ExitCode;

use {{ identifier }}::{greeting, sum_two};

fn main() -> ExitCode {
    let numbers: Vec<i64> = env::args()
        .skip(1)
        .filter_map(|argument| argument.parse::<i64>().ok())
        .collect();

    if numbers.is_empty() {
        println!("{}", greeting());
    } else {
        let total = numbers.iter().fold(0, |total, value| sum_two(total, *value));
        println!("{total}");
    }

    ExitCode::SUCCESS
}
