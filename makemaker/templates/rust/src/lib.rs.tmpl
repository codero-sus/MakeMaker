//! {{ app_name }} -- {{ app_summary }}
//!
//! Framework-free logic, kept separate from the binary so it can be unit
//! tested and reused.
//!
//! Generated by MakeMaker.

/// Human readable application name.
pub const APP_NAME: &str = "{{ app_name }}";

/// Adds two integers.
pub fn sum_two(a: i64, b: i64) -> i64 {
    a + b
}

/// The message the CLI prints.
pub fn greeting() -> String {
    format!("{} says hello (2 + 3 = {})", APP_NAME, sum_two(2, 3))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn adds_two_numbers() {
        assert_eq!(sum_two(2, 3), 5);
    }

    #[test]
    fn adds_negative_numbers() {
        assert_eq!(sum_two(-4, 4), 0);
    }

    #[test]
    fn app_name_is_set() {
        assert_eq!(APP_NAME, "{{ app_name }}");
    }

    #[test]
    fn greets_with_the_app_name() {
        assert_eq!(greeting(), "{{ app_name }} says hello (2 + 3 = 5)");
    }
}
