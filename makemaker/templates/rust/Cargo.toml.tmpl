# {{ app_name }} -- generated by MakeMaker
[package]
name = "{{ slug }}"
version = "{{ version }}"
edition = "{{ rust_edition }}"
description = "{{ app_summary }}"
license = "MIT"
authors = ["{{ author }}"]
readme = "README.md"

[lib]
name = "{{ identifier }}"
path = "src/lib.rs"

[[bin]]
name = "{{ identifier }}"
path = "src/main.rs"

# No dependencies: the standard library is enough.
[dependencies]

[profile.release]
lto = true
strip = true
